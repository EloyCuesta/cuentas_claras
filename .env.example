# Copia este archivo como .env (cp .env.example .env; en Windows, copy .env.example .env)
# y escribe tu código y los datos de MySQL. .env no se sube al repositorio.
#
# CUENTAS_CODIGO: código de acceso a las finanzas. Obligatorio, al menos 4
# caracteres. Quien no lo sepa solo puede usar la Despensa.
CUENTAS_CODIGO=

# MySQL Server (README, «Preparar MySQL»). La base de datos tiene que existir:
# la aplicación crea sus tablas, pero no la base.
CUENTAS_DB_HOST=127.0.0.1
CUENTAS_DB_PORT=3306
CUENTAS_DB_USER=
CUENTAS_DB_PASSWORD=
CUENTAS_DB_NAME=cuentas_claras
