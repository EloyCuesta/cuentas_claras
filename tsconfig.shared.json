{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.shared.tsbuildinfo",
    "target": "es2023",
    /* DOM solo por la Web Crypto (crypto.randomUUID en ids.ts): existe igual en el navegador y en Node. */
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* Sin tipos de Node ni de Vite: shared/ es lógica pura que usan la web y el servidor. */
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode, como la web */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["shared"]
}
