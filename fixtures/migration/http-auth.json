          "name": "consultar como invitado",
          "request": {
            "method": "GET",
            "path": "/api/auth/me"
          },
          "expected": {
            "status": 200,
            "body": {
              "ok": true,
              "data": {
                "rol": "invitado"
              }
            },
            "headers": {
              "cache-control": "no-store",
              "content-type": "application/json; charset=utf-8",
              "set-cookie": null,
              "retry-after": null
            }
          }
        },
